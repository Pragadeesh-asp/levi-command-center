{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LEVI COMMAND CENTER",
  "version": "0.1.0",
  "identifier": "com.local.claude-command-center",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://127.0.0.1:5173", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "windows": [{ "title": "LEVI COMMAND CENTER", "width": 1440, "height": 940, "minWidth": 1024, "minHeight": 720 }], "security": { "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost" } },
  "bundle": { "active": true, "targets": ["nsis", "msi"], "category": "Productivity", "shortDescription": "Your Personal AI Operations Headquarters" },
  "plugins": { "sql": { "preload": ["sqlite:command-center.db"] } }
}
